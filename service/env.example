# Database Configuration
DATABASE_NAME=learning_platform
DATABASE_URL=jdbc:postgresql://localhost:5432/learning_platform
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_password
DATABASE_MAX_POOL_SIZE=10
# Учебные данные (db/seed) — только локально
DATABASE_SEED=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=change_this_secret_key_in_production_to_random_string
JWT_ISSUER=backend-starter-course
JWT_AUDIENCE=backend-starter-course-users
# секунды
JWT_ACCESS_TOKEN_EXPIRATION=3600
JWT_REFRESH_TOKEN_EXPIRATION=604800

# Rate limit, запросов в минуту
RATE_LIMIT_AUTH=5
RATE_LIMIT_API=100

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Пустые логин и пароль — письма не отправляются, в лог пишется предупреждение
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@learning-platform.com

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,https://your-frontend.com

# File Storage
FILE_STORAGE_PATH=/app/uploads
MAX_FILE_SIZE=10485760

# Logging
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development

